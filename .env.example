# ══════════════════════════════════════════════════════════════════
# RIDDY Platform — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# NUNCA commite o arquivo .env — ele está no .gitignore.
# ══════════════════════════════════════════════════════════════════

# ── Banco de Dados ────────────────────────────────────────────────
# String de conexão MySQL/TiDB
DATABASE_URL=mysql://user:password@host:3306/riddy_db

# ── Autenticação JWT ──────────────────────────────────────────────
# String longa e aleatória para assinar os tokens JWT
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_string_secreta_longa_aqui

# ── Manus OAuth ───────────────────────────────────────────────────
# IDs e URLs do provedor OAuth Manus
VITE_APP_ID=seu_app_id_manus
OAUTH_SERVER_URL=https://oauth.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im
OWNER_OPEN_ID=seu_open_id_manus
OWNER_NAME=Seu Nome

# ── Google OAuth ──────────────────────────────────────────────────
# Credenciais do Google para login social
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# ── Mercado Pago ─────────────────────────────────────────────────
# Credenciais do Mercado Pago (use modo TEST para desenvolvimento)
# Obtenha em: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
VITE_MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=seu_webhook_secret_mp

# ── Stripe ───────────────────────────────────────────────────────
# Credenciais Stripe (use chaves de teste sk_test_ / pk_test_)
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_publica

# ── Cloudinary (Upload de Imagens) ───────────────────────────────
# Credenciais para upload e processamento de imagens
# Obtenha em: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=seu_api_secret_cloudinary

# ── Resend (E-mail Transacional) ─────────────────────────────────
# API key para envio de e-mails
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM_ADDRESS=noreply@riddycar.com

# ── Twilio (OTP / SMS) ───────────────────────────────────────────
# Credenciais para verificação via SMS
# Obtenha em: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token_twilio
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (Inteligência Artificial) ─────────────────────────────
# API key para funcionalidades de IA
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-sua_chave_openai

# ── Web Push Notifications (VAPID) ───────────────────────────────
# Chaves para notificações push no browser
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=sua_vapid_public_key
VAPID_PRIVATE_KEY=sua_vapid_private_key
VAPID_EMAIL=admin@riddycar.com

# ── Manus Built-in APIs ───────────────────────────────────────────
# Injetadas automaticamente pela plataforma Manus — não edite
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
